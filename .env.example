# Copy this file to .env for local development (`vercel env pull` will also
# generate a working .env.local once these are set in the Vercel dashboard).
# NEVER commit a real .env file, and never paste real values into this one.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
# The "service_role" secret key — NOT the "anon public" key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail (Nodemailer) -----------------------------------------------------
# The Gmail address that will send notification/receipt emails.
GMAIL_USER=
# A 16-character Google "App Password", not your normal Gmail password.
# Requires 2-Step Verification to be enabled on the account first.
# See SETUP.md for exact steps.
GMAIL_APP_PASSWORD=

# --- Notifications -----------------------------------------------------------
# Where new-booking-request emails get sent. Can be the same as GMAIL_USER.
BOOKING_NOTIFICATION_EMAIL=
