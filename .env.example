# Copy this file to .env for local development (`vercel env pull` will also
# generate a working .env.local once these are set in the Vercel dashboard).
# NEVER commit a real .env file, and never paste real values into this one.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
# The "service_role" secret key — NOT the "anon public" key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email delivery) ------------------------------------------------
# API key from resend.com -> API Keys. Server-only, never exposed to the browser.
RESEND_API_KEY=
# Sender identity for both the owner notification and the customer receipt.
# Must be on a domain verified in Resend — see SETUP.md for exact GoDaddy DNS steps.
MAIL_FROM=Aidenn’s Tutoring <aidenn@aidennstutoring.org>
# Where customer replies should land (used as the receipt email's Reply-To).
MAIL_REPLY_TO=aidenn@aidennstutoring.org
# Production site origin, used to build the logo image URL embedded in
# transactional emails. Defaults to https://aidennstutoring.org if unset.
SITE_URL=https://aidennstutoring.org

# --- Notifications -----------------------------------------------------------
# Primary recipient of the owner notification email for each new booking request.
BOOKING_NOTIFICATION_TO=aidennq29@gmail.com
# Comma-separated BCC list on the owner notification (never on the customer
# receipt). Entries are trimmed, validated, and de-duplicated server-side —
# a malformed entry is skipped rather than breaking the send.
BOOKING_NOTIFICATION_BCC=aidenn@aidennstutoring.com,aidenn@aidennstutoring.org

# --- Admin auth ---------------------------------------------------------------
# The admin passcode is hardcoded server-only in api/_lib/adminAuth.js (not
# an env var) — never imported by /src, so it can't reach the client bundle.
# Rotate it by editing that constant directly and redeploying.
# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Random secret used to hash client IPs for login rate-limiting (raw IPs are
# never stored). Generate with a second, DIFFERENT run of:
#   openssl rand -hex 32
IP_HASH_SECRET=
# Comma-separated origins allowed to call /api/admin/* mutation routes, for
# CSRF protection. Add your production domain(s) here once deployed.
# localhost and *.vercel.app preview URLs are always allowed automatically.
ALLOWED_ADMIN_ORIGINS=https://aidennstutoring.org,https://www.aidennstutoring.org

# --- Booking calendar -----------------------------------------------------
# How many months into the future visitors can browse/book. Past dates are
# never navigable regardless of this value.
BOOKING_HORIZON_MONTHS=6
